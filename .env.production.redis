# ============================================================
# .env PRODUCTION — VPS (dengan Redis)
# Salin isi ini ke /var/www/Backend_Siswa/.env jika Redis tersedia
# ============================================================

APP_NAME='LMS Backend Siswa'
APP_ENV=production
APP_KEY=base64:cOv/yELK9mk+UghMA8gfYbGv+7sut5toSfnpIZTBSrc=
APP_DEBUG=false
APP_URL=http://151.243.222.93:30083
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=10

# ============================================================
# LOGGING — production pakai level error saja
# ============================================================
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# ============================================================
# DATABASE UTAMA
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_db
DB_USERNAME=laravel_user
DB_PASSWORD=Password123!

# Database terpisah untuk logging quiz activity
DB_LOG_HOST=127.0.0.1
DB_LOG_PORT=3306
DB_LOG_DATABASE=laravel_log
DB_LOG_USERNAME=laravel_user
DB_LOG_PASSWORD=Password123!

# ============================================================
# SESSION — pakai Redis (lebih cepat dari database)
# ============================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ============================================================
# CACHE — pakai Redis
# ============================================================
CACHE_STORE=redis

# ============================================================
# QUEUE — pakai Redis
# ============================================================
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# ============================================================
# REDIS
# ============================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ============================================================
# FILESYSTEM
# ============================================================
FILESYSTEM_DISK=public

# ============================================================
# JITSI
# ============================================================
JITSI_DOMAIN=https://meet.jit.si

# ============================================================
# SANCTUM
# ============================================================
SANCTUM_TOKEN_EXPIRATION=10080

# ============================================================
# MAIL (dummy — tidak dipakai)
# ============================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@lms.app"
MAIL_FROM_NAME="${APP_NAME}"
