# ============================================================
# .env PRODUCTION — VPS (tanpa Redis / Redis tidak tersedia)
# Salin isi ini ke /var/www/Backend_Siswa/.env jika Redis TIDAK tersedia
# ============================================================

APP_NAME='LMS Backend Siswa'
APP_ENV=production
APP_KEY=base64:cOv/yELK9mk+UghMA8gfYbGv+7sut5toSfnpIZTBSrc=
APP_DEBUG=false
APP_URL=http://151.243.222.93:30083
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=10

# ============================================================
# LOGGING — production pakai level error saja
# ============================================================
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# ============================================================
# DATABASE UTAMA
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_db
DB_USERNAME=laravel_user
DB_PASSWORD=Password123!

# Database terpisah untuk logging quiz activity
# Jika belum ada DB terpisah, samakan dengan DB utama
DB_LOG_HOST=127.0.0.1
DB_LOG_PORT=3306
DB_LOG_DATABASE=laravel_db_log
DB_LOG_USERNAME=laravel_user
DB_LOG_PASSWORD=Password123!

# ============================================================
# SESSION — pakai file (lebih ringan dari database tanpa Redis)
# ============================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ============================================================
# CACHE — pakai file
# ============================================================
CACHE_STORE=file

# ============================================================
# QUEUE — sync (tidak butuh worker)
# ============================================================
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# ============================================================
# FILESYSTEM
# ============================================================
FILESYSTEM_DISK=public

# ============================================================
# JITSI
# ============================================================
JITSI_DOMAIN=https://meet.jit.si

# ============================================================
# SANCTUM
# ============================================================
SANCTUM_TOKEN_EXPIRATION=10080

# ============================================================
# MAIL (dummy — tidak dipakai)
# ============================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@lms.app"
MAIL_FROM_NAME="${APP_NAME}"
